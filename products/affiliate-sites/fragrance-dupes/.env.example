# Copy to .env.local and fill in once real values exist. Every one of these
# is optional at build time - the site builds and runs correctly with none
# of them set (GA4/GSC wiring renders nothing; NEXT_PUBLIC_SITE_URL falls
# back to a placeholder used in metadata/sitemap/robots).

# Canonical site URL, used in metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://example-placeholder.com

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset and no GA script loads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML meta-tag verification token. Leave unset and no
# verification meta tag renders.
NEXT_PUBLIC_GSC_VERIFICATION=

# Public contact address shown on /contact. Must be a real, MONITORED inbox on
# the site's own domain before any affiliate application is filed - affiliate
# managers reply there, and a dead contact page is a common silent reason for
# a merchant application to be declined. Leave unset and /contact honestly
# says contact is not open yet rather than printing an address nobody watches.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Marketplace / producer program
# ---------------------------------------------------------------------------
# NONE OF THESE ARE PROVISIONED. The marketplace code (prisma/schema.prisma,
# app/api/subscribe, app/api/webhooks/stripe, app/producers) is written and
# typechecks, but is inert until real values land here. See
# PRODUCER-PROGRAM.md §8 for the ordered list of what has to exist first.
# Creating these accounts is founder-side work - it needs real business
# identity, bank, and tax details that cannot be scripted.

# Postgres. Supabase or Neon; see MARKETPLACE-PLAN.md §4.
# Note `prisma validate` needs this set to *something* well-formed even
# offline, hence the placeholder rather than an empty value.
DATABASE_URL=postgresql://user:password@localhost:5432/drydown?schema=public

# Payment provider: NOT CHOSEN, and deliberately not Stripe.
# Sirketim is a Turkey-based business and Stripe does not support Turkish
# accounts (verified against stripe.com/global). The Stripe integration that
# once lived here was deleted 2026-08-27. Paddle is the expected replacement
# (merchant of record, absorbs EU/UK/US VAT); iyzico/PayTR are the domestic
# alternatives. Nothing is needed here until a producer agrees to pay -
# the free tier requires no payment rail at all.
# See FINALIZATION-GUIDE.md phase 5 and departments/accounting/CLAUDE.md.

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Local-only preview of the gated producer pages (/producers/submit), so the
# gated UI can be reviewed before authentication exists. Set to 1 and restart
# `npm run dev`.
#
# This CANNOT be enabled in a production build: lib/producer-session.ts also
# requires NODE_ENV === "development", which the bundler inlines at build
# time. An env-var-only switch here would be a genuine auth-bypass hole once
# this deploys. Pages using it render a visible preview banner.
PRODUCER_PREVIEW=
