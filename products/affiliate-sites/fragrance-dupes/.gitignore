# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated at build time by scripts/generate-redirects.mjs from
# lib/affiliate-links.ts. Regenerated on every build (including on the host),
# and carries a timestamp, so committing it would only produce noisy diffs
# and risk a stale redirect table shipping.
/public/_redirects

# Raw affiliate product feeds — large, licensed data, not ours to redistribute
# in a public repo. Ingested locally into typed data files; the feed itself
# stays out. The README stays tracked. See scripts/feeds/README.md.
/scripts/feeds/*
!/scripts/feeds/README.md
