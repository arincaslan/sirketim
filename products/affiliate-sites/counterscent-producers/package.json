{
  "name": "counterscent-producers",
  "version": "0.0.0",
  "private": true,
  "description": "Producer console for counterscent.com, on its own origin. Self-contained: this is not part of the catalogue's build and shares no dependencies with it.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-constants.mjs",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
