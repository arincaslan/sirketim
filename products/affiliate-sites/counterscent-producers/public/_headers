# Headers for the STATIC ASSETS only.
#
# WHY THIS FILE HAS TO EXIST. Requests that match a file under public/ are
# served by Cloudflare's asset layer and never reach src/index.ts, so they do
# NOT get the headers in src/lib/http.ts. Without this file the stylesheet,
# the script and the fonts would be the only responses on the origin without
# `X-Robots-Tag: noindex` on them. Nothing terrible follows from an indexed
# stylesheet, but "every response carries the header" is either true or it is
# a thing somebody has to re-check, and re-checking it is how it stops being
# true.
#
# Verify after any change: `curl -sI http://127.0.0.1:8787/assets/console.css`
# under `wrangler dev` should show the header. If it does not, this file is
# not being applied and the fallback is `run_worker_first` in wrangler.jsonc,
# at the cost of a Worker invocation per asset.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The two font files are content-stable: if either is ever replaced, the new
# one gets a new filename rather than the same name with different bytes.
# That is what makes a year of immutable caching safe here.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet and the theme script WILL change, and both are small. A short
# max-age plus the ETag the asset layer already sends makes a revalidation
# cheap and a stale copy short-lived.
/assets/console.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/theme.js
  Cache-Control: public, max-age=3600, must-revalidate
